# License Server Configuration
# Copy this file to .env and fill in your actual values

# License Server URL
# This is the URL of your license validation server
LICENSE_SERVER_URL=mewbot-production-c860.up.railway.app

# License Server Secret Key
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
LICENSE_SERVER_SECRET_KEY=eye74hyhwhi892746hqdno8yrhwi9y080r3y

# License Validation Interval (seconds)
# How often the client should validate the license with the server
# Default: 300 (5 minutes)
LICENSE_VALIDATION_INTERVAL=300

# License Grace Period (seconds)
# How long the client can operate offline without server validation
# Default: 1800 (30 minutes)
LICENSE_GRACE_PERIOD=1800

# License Bot Configuration (for administrators only)

# Telegram Bot Token for License Management
# Get this from @BotFather on Telegram
LICENSE_BOT_TOKEN=8999497146:AAHiDj-4vGFH9bgBUZwlH1t60mgbCGzH2n0

# Admin Telegram User IDs (comma-separated)
# Only these users can access the license management bot
# Get your Telegram ID from @userinfobot
LICENSE_BOT_ADMIN_IDS=6929510084

# License Server Host (for server process)
# The interface the license server should bind to
# Use 0.0.0.0 to listen on all interfaces (for remote clients)
# Use 127.0.0.1 to listen only on localhost (for local testing)
LICENSE_SERVER_HOST=0.0.0.0

# License Server Port (for server process)
LICENSE_SERVER_PORT=8080
