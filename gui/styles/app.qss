/* Telegram Meow Bot — visual theme
   Palette: deep slate background, indigo accent (#6C5CE7), amber for
   warnings, soft red for danger/stop, green for success/running. */

* {
    font-family: "Vazirmatn", "Segoe UI", "Tahoma", sans-serif;
    font-size: 14px;
    outline: none;
}

QMainWindow, QWidget {
    background-color: #14161a;
    color: #e9e9ee;
}

QWidget#body {
    background-color: #14161a;
}

/* ---------------- Sidebar ---------------- */

QWidget#sidebarPanel {
    background-color: #191b20;
    border-radius: 14px;
}

QLabel#appTitle {
    font-size: 16px;
    font-weight: 700;
    color: #f1f0ff;
}

QLabel#appSubtitle {
    font-size: 11px;
    color: #7d818c;
}

QLabel#versionLabel {
    font-size: 11px;
    color: #5c606b;
    padding: 6px 4px;
}

QListWidget#sidebar {
    background: transparent;
    border: none;
    padding: 4px;
    min-width: 190px;
}

QListWidget#sidebar::item {
    padding: 11px 14px;
    border-radius: 10px;
    margin: 3px 4px;
    color: #b7bac3;
    font-size: 14px;
}

QListWidget#sidebar::item:selected {
    background-color: #6c5ce7;
    color: white;
    font-weight: 600;
}

QListWidget#sidebar::item:hover:!selected {
    background-color: #23262d;
    color: #e9e9ee;
}

/* ---------------- Cards ---------------- */

QFrame#card {
    background-color: #1b1e24;
    border: 1px solid #262a32;
    border-radius: 14px;
}

QLabel#cardTitle {
    font-size: 13px;
    font-weight: 700;
    color: #d6d7dd;
}

QLabel#cardHint {
    color: #7d818c;
    font-size: 11.5px;
}

/* ---------------- Status pill ---------------- */

QLabel#statusPill {
    border-radius: 13px;
    padding: 6px 16px;
    font-weight: 700;
    font-size: 13px;
}

QLabel#uptimeValue {
    font-size: 20px;
    font-weight: 700;
    color: #f1f0ff;
    font-family: "Consolas", "Courier New", monospace;
}

/* ---------------- Buttons ---------------- */

QPushButton {
    background-color: #2a2d35;
    color: #e9e9ee;
    border: 1px solid #333741;
    border-radius: 9px;
    padding: 9px 18px;
    font-weight: 600;
}

QPushButton:hover { background-color: #333741; }
QPushButton:pressed { background-color: #2a2d35; }
QPushButton:disabled { background-color: #202329; color: #565a63; border-color: #262a32; }

QPushButton#primaryBtn {
    background-color: #6c5ce7;
    border: 1px solid #7d6ff0;
    color: white;
    padding: 11px 26px;
    font-size: 14px;
}
QPushButton#primaryBtn:hover { background-color: #7d6ff0; }
QPushButton#primaryBtn:pressed { background-color: #5b4bd6; }
QPushButton#primaryBtn:disabled { background-color: #2d2f3a; border-color: #2d2f3a; color: #5c5f6b; }

QPushButton#dangerBtn {
    background-color: #e2574c;
    border: 1px solid #e97169;
    color: white;
    padding: 11px 26px;
    font-size: 14px;
}
QPushButton#dangerBtn:hover { background-color: #e97169; }
QPushButton#dangerBtn:pressed { background-color: #c8493f; }
QPushButton#dangerBtn:disabled { background-color: #2d2f3a; border-color: #2d2f3a; color: #5c5f6b; }

QPushButton#ghostBtn {
    background-color: transparent;
    border: 1px solid #333741;
    color: #b7bac3;
    padding: 7px 14px;
    font-weight: 500;
    font-size: 12.5px;
}
QPushButton#ghostBtn:hover { background-color: #23262d; color: #e9e9ee; }

QToolButton {
    background-color: #23262d;
    border: 1px solid #333741;
    border-radius: 8px;
    padding: 5px 9px;
    color: #b7bac3;
}
QToolButton:hover { background-color: #2c2f38; color: #e9e9ee; }
QToolButton:checked { background-color: #6c5ce7; color: white; border-color: #7d6ff0; }

/* ---------------- Inputs ---------------- */

QLineEdit, QSpinBox {
    background-color: #20232a;
    border: 1px solid #2e323b;
    border-radius: 8px;
    padding: 8px 10px;
    color: #e9e9ee;
    selection-background-color: #6c5ce7;
}
QLineEdit:focus, QSpinBox:focus { border: 1px solid #6c5ce7; background-color: #22252c; }
QLineEdit::placeholder { color: #5c606b; }

QSpinBox::up-button, QSpinBox::down-button { width: 16px; border: none; }

QCheckBox { color: #b7bac3; spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border-radius: 5px;
    border: 1px solid #3a3e48;
    background: #20232a;
}
QCheckBox::indicator:checked { background: #6c5ce7; border-color: #6c5ce7; }

/* ---------------- Terminal / log panel ---------------- */

QPlainTextEdit#terminal {
    background-color: #101216;
    color: #d5d6dc;
    border: 1px solid #232630;
    border-radius: 10px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 12.5px;
    padding: 8px;
    selection-background-color: #6c5ce7;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #333741;
    border-radius: 5px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover { background: #40444f; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }

/* ---------------- Tabs (Settings) ---------------- */

QTabWidget::pane {
    border: 1px solid #262a32;
    border-radius: 12px;
    background-color: #1b1e24;
    top: 4px;
}
QTabBar { qproperty-drawBase: 0; }
QTabBar::tab {
    background: transparent;
    color: #8a8e99;
    padding: 9px 16px;
    margin: 2px 3px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 12.5px;
}
QTabBar::tab:selected { background: #6c5ce7; color: white; }
QTabBar::tab:hover:!selected { background: #23262d; color: #d6d7dd; }

/* ---------------- Misc ---------------- */

QLabel#hint { color: #7d818c; font-size: 11.5px; }
QLabel#sectionDesc { color: #9296a1; font-size: 12px; }

QMessageBox {
    background-color: #1b1e24;
}
QMessageBox QLabel { color: #e9e9ee; }
QMessageBox QPushButton {
    background-color: #6c5ce7;
    border: 1px solid #7d6ff0;
    color: white;
    min-width: 70px;
    padding: 7px 16px;
}
QMessageBox QPushButton:hover { background-color: #7d6ff0; }

QDialog#loginDialog {
    background-color: #191b20;
}
QDialog#loginDialog QLabel#loginTitle {
    font-size: 16px;
    font-weight: 700;
    color: #f1f0ff;
}
QDialog#loginDialog QLabel#loginSubtitle {
    color: #8a8e99;
    font-size: 12px;
}
